{
  "manifest_version": 3,
  "name": "YGO Duel Odds",
  "version": "0.1.0",
  "description": "Live odds for your opponent's face-down cards, hand and next draw on DuelingBook, updated as the duel happens.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://www.duelingbook.com/*", "https://duelingbook.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Open YGO Duel Odds"},
  "side_panel": {"default_path": "panel.html"},
  "content_scripts": [
    {
      "matches": ["https://www.duelingbook.com/*", "https://duelingbook.com/*"],
      "js": ["page-hook.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.duelingbook.com/*", "https://duelingbook.com/*"],
      "js": ["tracker.js"],
      "run_at": "document_idle"
    }
  ]
}
