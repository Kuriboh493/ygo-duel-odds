{
  "manifest_version": 3,
  "name": "YGO Duel Odds",
  "version": "0.4.0",
  "description": "Live odds for your opponent's face-down cards, hand, next draw and deck on DuelingBook, updated as the duel happens.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://www.duelingbook.com/*",
    "https://duelingbook.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Open YGO Duel Odds",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "sidebar_action": {
    "default_panel": "panel.html",
    "default_title": "YGO Duel Odds",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.duelingbook.com/*",
        "https://duelingbook.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.duelingbook.com/*",
        "https://duelingbook.com/*"
      ],
      "js": [
        "tracker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ygo-duel-odds@kuriboh493",
      "strict_min_version": "128.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-hook.js"
      ],
      "matches": [
        "https://www.duelingbook.com/*",
        "https://duelingbook.com/*"
      ]
    }
  ]
}
